1- 	Retrieve movies released in 2006 with a rental rate greater than or equal to 4.0:

	select * from film where rental_rate >=4.0 and release_year=2006 ;
	------------------------------------------------------------

2-  	first 10 movies from the movie table, sorted by length in ascending order:

	select * from film order by length ASC limit 10;
	------------------------------------------------------------

3- 	the number of customers in each country, sorted by country name in ascending order:

	SELECT country,COUNT(*) AS count_customer FROM customer
	JOIN address ON customer.address_id=address.address_id
	JOIN city ON address.city_id=city.city_id
	JOIN country ON city.country_id=country.country_id 
	GROUP BY country.country
	ORDER BY country.country ASC;
	------------------------------------------------------------
	
4-  	title ,rental_duartion and average rental rate each movie according to title movie ascending : 

	SELECT title,rental_duration,avg(rental_rate)
	FROM film
	GROUP BY title,rental_duration
	ORDER BY title ASC;
	------------------------------------------------------------
	
5- 	10 top customer that rental most movie with count of rental movie:

	select count(rental_id) as count_rental,customer.first_name || customer.last_name as name from rental 
	join customer on rental.customer_id=customer.customer_id
	group by customer.first_name,customer.last_name 
	order by count_rental DESC limit 10;
	------------------------------------------------------------
	
6- 	customer that live in United States and first name start with 'A':

	select first_name || last_name as name from customer
	join address on customer.address_id=address.address_id 
	join city on address.city_id=city.city_id
	join country on city.country_id= country.country_id
	where country ='United States' and first_name like 'A%';
	------------------------------------------------------------
	
7- 	movie that rental_duration more than 5 and replacement_cost less than 15:

	select title,rental_duration,replacement_cost from film
	where rental_duration>5 and replacement_cost<15;
